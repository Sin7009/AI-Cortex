# AI-Cortex Configuration File
# Скопируйте этот файл как .env и заполните своими значениями

# ============================================
# Telegram Bot Configuration (обязательно)
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here


# ============================================
# Model Provider Configuration
# ============================================
# Выберите один из вариантов:

# --- Вариант 1: OpenRouter (рекомендуется: бесплатно + качество) ---
# Использует Grok (бесплатно в бете) и локальные эмбеддинги
MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-......
OPENROUTER_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# --- Вариант 2: Ollama (локальная модель) ---
# MODEL_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2

# --- Вариант 3: GigaChat API (внешний) ---
# MODEL_PROVIDER=gigachat
# GIGACHAT_API_KEY=your_gigachat_api_key_here


# ============================================
# Дополнительные настройки (опционально)
# ============================================

# Логирование
# LOG_LEVEL=INFO

# ChromaDB
# CHROMA_PERSIST_DIRECTORY=chroma_db
