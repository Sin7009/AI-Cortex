# AI-Cortex Configuration File
# Скопируйте этот файл как .env и заполните своими значениями

# ============================================
# Telegram Bot Configuration (обязательно)
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here


# ============================================
# Model Provider Configuration
# ============================================
# Выберите один из вариантов:

# --- Вариант 1: GigaChat API (внешний, по умолчанию) ---
# Используйте для быстрого старта без своего сервера
MODEL_PROVIDER=gigachat
GIGACHAT_API_KEY=your_gigachat_api_key_here


# --- Вариант 2: Ollama (локальная модель, рекомендуется для Debian 12) ---
# Раскомментируйте эти строки для использования локальной модели
# MODEL_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434


# --- Вариант 3: HuggingFace (локальная модель, для продвинутых пользователей) ---
# Требует мощный сервер с GPU
# MODEL_PROVIDER=huggingface
# HUGGINGFACE_MODEL=IlyaGusev/saiga_llama3_8b


# ============================================
# Дополнительные настройки (опционально)
# ============================================

# Логирование
# LOG_LEVEL=INFO

# ChromaDB
# CHROMA_PERSIST_DIRECTORY=chroma_db


# ============================================
# Справка
# ============================================
# 
# Для GigaChat API:
# - Получите ключ на: https://developers.sber.ru/gigachat
# 
# Для Ollama на Debian 12:
# - Запустите: bash setup_debian12.sh
# - Или следуйте инструкциям в DEPLOYMENT.md
# 
# Сравнение вариантов: см. COMPARISON.md
# Детальная документация: см. README.md
